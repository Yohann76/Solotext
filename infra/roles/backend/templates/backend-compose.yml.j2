version: '3.8'

services:
  backend:
    image: "{{ app_name }}-backend:latest"
    container_name: solotext-backend
    ports:
      - "{{ backend_port }}:3000"
    env_file:
      - backend/.env
    volumes:
      - {{ app_dir }}/backend:/app
      - /app/node_modules
    networks:
      - solotext-network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    command: sh -c "npx sequelize-cli db:migrate && npm start"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  rabbitmq:
    image: rabbitmq:{{ rabbitmq_version }}
    container_name: solotext-rabbitmq
    ports:
      - "{{ rabbitmq_port }}:5672"
      - "{{ rabbitmq_management_port }}:15672"
    environment:
      - RABBITMQ_DEFAULT_USER=admin
      - RABBITMQ_DEFAULT_PASS=admin123
      - RABBITMQ_DEFAULT_VHOST=/
    volumes:
      - {{ rabbitmq_data_dir }}:/var/lib/rabbitmq
    networks:
      - solotext-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5

  analysis-worker:
    image: "{{ app_name }}-worker:latest"
    container_name: solotext-analysis-worker
    env_file:
      - backend/.env
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    networks:
      - solotext-network
    restart: unless-stopped
    volumes:
      - {{ app_dir }}/backend:/app
      - /app/node_modules

networks:
  solotext-network:
    external: true
    name: solotext-network

