version: '3.8'

services:
  postgres:
    image: postgres:{{ postgres_version }}
    container_name: solotext-postgres
    env_file:
      - .env.postgres
    ports:
      - "{{ postgres_port }}:5432"
    volumes:
      - {{ postgres_data_dir }}:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }} -d {{ db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - solotext-network

networks:
  solotext-network:
    driver: bridge

